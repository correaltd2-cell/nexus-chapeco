rules_version = '2';
/* A trava de verdade do sistema. Esconder o item do menu nao é acesso negado.
   O papel vive no perfil; quem esta inativo nao passa em lugar nenhum. */
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function perfil() { return get(/databases/$(database)/documents/perfis/$(request.auth.uid)).data; }
    function ativo() { return logado() && perfil().ativo == true; }
    function papel() { return ativo() ? perfil().papel : 'nenhum'; }
    function gestao() { return papel() in ['admin', 'gestor']; }
    function equipe() { return papel() in ['admin', 'gestor', 'recepcao', 'coordenacao', 'professor']; }
    function veTudo() { return papel() in ['admin', 'gestor', 'recepcao']; }
    /* quem atende (26/11/2026): todos menos o professor, que só tem a agenda dele */
    function atende() { return papel() in ['admin', 'gestor', 'recepcao', 'coordenacao']; }
    function meusSetores() { return ativo() ? perfil().get('setores', []) : []; }
    function veSetor(setor) { return veTudo() || (papel() == 'coordenacao' && setor in meusSetores()); }
    /* a conversa de uma mensagem: a coordenação só lê mensagem de conversa do setor dela */
    function veConversa(conversaId) {
      return veTudo() || (papel() == 'coordenacao'
        && get(/databases/$(database)/documents/conversas/$(conversaId)).data.setor in meusSetores());
    }

    /* Equipe: cada um lê o próprio perfil; a gestão lê e escreve todos.
       Ninguém muda o próprio papel, setores ou ativo pela API. */
    match /perfis/{uid} {
      allow read: if ativo() && (uid == request.auth.uid || equipe());
      allow create, delete: if gestao();
      allow update: if gestao()
        || (uid == request.auth.uid
            && request.resource.data.papel == resource.data.papel
            && request.resource.data.setores == resource.data.setores
            && request.resource.data.ativo == resource.data.ativo
            && request.resource.data.get('daAula', false) == resource.data.get('daAula', false));
    }

    /* O vínculo com o portal de provas (portalStudentId e companhia) só muda pelo
       servidor (/api/provas/portal/vinculo), que confere o aluno no portal e registra
       quem fez: o navegador não grava esses campos, nem ao criar nem ao mudar. */
    function camposDoPortal() { return ['portalStudentId', 'portalNome', 'portalVinculadoPor', 'portalVinculadoEm']; }
    match /alunos/{id} {
      /* a ficha do aluno (telefone, contrato) é de quem atende; o professor vê os nomes
         dentro das aulas dele */
      allow read: if atende();
      allow create: if (veTudo() || papel() == 'coordenacao')
        && !request.resource.data.keys().hasAny(camposDoPortal());
      allow update: if (veTudo() || papel() == 'coordenacao')
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposDoPortal());
      allow delete: if veTudo() || papel() == 'coordenacao';
    }

    /* Provas do portal (24/11/2026): a liberação e os envios de cada prova
       (provas_portal) e o registro de quem fez o quê (provas_portal_log) só o servidor
       grava. A trava de uma liberação por vez (provas_portal_travas) nem se lê: não tem
       regra, fica fechada. (provas e provas_envios, mais abaixo, são do plano antigo de
       provas feitas aqui dentro, que não chegou a ser usado.) */
    match /provas_portal/{id}     { allow read: if veTudo() || papel() == 'coordenacao'; allow write: if false; }
    match /provas_portal_log/{id} { allow read: if gestao(); allow write: if false; }

    /* a coordenação vê só as conversas do setor dela (Natan, Coordenação; Karina,
       Coordenação Kids) e por isso pede já filtrado (dados/conversas.ts); o professor
       não vê conversa nenhuma */
    match /conversas/{id} {
      allow read: if atende() && veSetor(resource.data.setor);
      allow create: if veTudo();
      allow update: if atende() && veSetor(resource.data.setor);
      allow delete: if gestao();
    }

    match /mensagens/{id} {
      /* a tela pede as mensagens de uma conversa (conversaId ==) ou uma mensagem pelo id */
      allow read: if atende() && veConversa(resource.data.conversaId);
      /* mensagem que sai pelo painel é gravada pela rota de API, com a chave de servico;
         o navegador só lê. Nota interna é a exceção e vem marcada. */
      allow create: if atende() && veConversa(request.resource.data.conversaId)
        && request.resource.data.autor in ['humano', 'sistema']
        && !('waMessageId' in request.resource.data);
      allow update, delete: if gestao();
    }

    match /quadros/{id} { allow read: if atende(); allow write: if atende(); }
    match /listas/{id}  { allow read: if atende(); allow write: if atende(); }
    match /cartoes/{id} { allow read: if atende(); allow write: if atende(); }

    match /provas/{id} {
      allow read: if equipe();
      allow write: if veTudo() || papel() in ['coordenacao', 'professor'];
    }
    match /provas_envios/{id} {
      allow read: if equipe();
      allow create, update: if veTudo() || papel() in ['coordenacao', 'professor'];
      allow delete: if gestao();
    }

    match /horarios/{id} {
      allow read: if equipe();
      allow write: if veTudo() || papel() == 'coordenacao';
    }
    match /marcacoes/{id} {
      allow read: if equipe();
      allow write: if equipe();
    }

    /* Mensagem escrita agora para sair depois. Quem envia de verdade é a rota do
       cron, com a chave de servico; aqui o time so programa e cancela. */
    match /agendadas/{id} {
      allow read: if atende();
      allow create, update: if atende();
      allow delete: if gestao();
    }

    match /templates/{id} { allow read: if atende(); allow write: if gestao(); }
    match /envios/{id}    { allow read: if atende(); allow write: if gestao(); }

    /* ---------- agenda ----------
       Admin, gestão, recepção e coordenação cuidam da agenda. O professor lê só as aulas
       DELE (26/11/2026; a tela pede por professorId) e, nelas, só muda o status e o que
       é de cada aluno (presença, obs e notas): não cria, não exclui, não remarca e não
       troca aluno. A mesma regra está em src/lib/dominio/agenda.ts (permissoesDe), que só
       decide o que a tela mostra. */
    function cuidaDaAgenda() { return papel() in ['admin', 'gestor', 'recepcao', 'coordenacao']; }
    function statusDaAula(s) { return s in ['agendado', 'confirmado', 'realizado', 'cancelado', 'remarcado']; }
    function aulaValida(d) {
      return d.inicio is string && d.fim is string && d.fim > d.inicio
        && statusDaAula(d.status) && d.professorId is string && d.alunoIds is list
        && d.modalidade in ['presencial', 'online'];
    }
    function professorDaAula(dados) { return papel() == 'professor' && dados.professorId == request.auth.uid; }

    match /agendamentos/{id} {
      allow read: if cuidaDaAgenda() || (papel() == 'professor' && resource.data.professorId == request.auth.uid);
      allow create, delete: if cuidaDaAgenda();
      allow update: if (cuidaDaAgenda() && aulaValida(request.resource.data))
        || (professorDaAula(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'alunos', 'atualizadoPor', 'atualizadoEm'])
            && statusDaAula(request.resource.data.status)
            && request.resource.data.alunos.size() == resource.data.alunos.size()
            && request.resource.data.atualizadoPor == request.auth.uid);

      /* o que é de cada aluno na aula */
      match /alunos/{alunoId} {
        allow read: if cuidaDaAgenda() || professorDaAula(get(/databases/$(database)/documents/agendamentos/$(id)).data);
        allow create, delete: if cuidaDaAgenda();
        allow update: if cuidaDaAgenda()
          || (professorDaAula(get(/databases/$(database)/documents/agendamentos/$(id)).data)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['presenca', 'obs', 'notas']));
      }
    }

    match /recorrencias/{id} { allow read: if equipe(); allow write: if cuidaDaAgenda(); }
    match /modulos/{id}      { allow read: if equipe(); allow write: if cuidaDaAgenda(); }
    match /aulas/{id}        { allow read: if equipe(); allow write: if cuidaDaAgenda(); }
    /* bloqueio é tipo próprio (feriado, férias, reunião, indisponível), nunca aula falsa */
    match /bloqueios/{id} {
      allow read: if equipe();
      allow write: if cuidaDaAgenda()
        && (request.resource == null
            || (request.resource.data.fim > request.resource.data.inicio
                && request.resource.data.tipo in ['feriado', 'ferias', 'reuniao', 'indisponivel']));
    }

    /* o registro de tudo o que mexeu na agenda: cada um grava o próprio, ninguém apaga */
    match /logs_agenda/{id} {
      allow read: if cuidaDaAgenda();
      allow create: if equipe() && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if false;
    }

    /* Configuração é da gestão. Atendimento e conexão do WhatsApp moram aqui. */
    match /config/{id} { allow read: if equipe(); allow write: if gestao(); }

    match /{document=**} { allow read, write: if false; }
  }
}
